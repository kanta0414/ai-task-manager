# ===== Database =====
# ローカル Homebrew PostgreSQL を使う場合(既定)
DATABASE_URL=postgresql+psycopg://kanta@localhost:5432/ai_task_manager
# docker compose の DB を使う場合はこちら
# DATABASE_URL=postgresql+psycopg://aitm:aitm@localhost:5433/ai_task_manager

# ===== App =====
APP_ENV=development
TIMEZONE=Asia/Tokyo
CORS_ORIGINS=http://localhost:3000

# ===== LLM (Phase 5 以降) =====
# 使用プロバイダ: claude | ollama
LLM_PROVIDER=claude
# 絶対に Git にコミットしない / フロントエンドへ渡さない
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
