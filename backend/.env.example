# ===== Database =====
# ローカル Homebrew PostgreSQL を使う場合(既定)
DATABASE_URL=postgresql+psycopg://kanta@localhost:5432/ai_task_manager
# docker compose の DB を使う場合はこちら
# DATABASE_URL=postgresql+psycopg://aitm:aitm@localhost:5433/ai_task_manager

# ===== App =====
APP_ENV=development
TIMEZONE=Asia/Tokyo
CORS_ORIGINS=http://localhost:3000
# ===== 認証 =====
# セッション用の署名鍵。**必ず環境ごとに変えること**
SECRET_KEY=変更してください（例: python -c "import secrets;print(secrets.token_urlsafe(48))"）

# ===== 外部カレンダー連携（任意）=====
# Google Cloud で OAuth クライアントを作成して設定する。
# 未設定なら連携機能は無効（アプリは通常どおり動く）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
FRONTEND_BASE_URL=http://localhost:3000

# ===== 非同期処理（Celery）=====
CELERY_BROKER_URL=redis://localhost:6379/0
# Redis が用意できない環境では、インストール不要の
# ファイルシステムブローカーに切り替えられる（開発用）
# CELERY_BROKER_URL=filesystem://

# ===== 自動スケジューリングの制約 =====
# この時間帯の外には予定を入れない（睡眠時間などを避けるため）
SCHEDULE_DAY_START_HOUR=9
SCHEDULE_DAY_END_HOUR=22

# ===== LLM =====
# 使用プロバイダ: ollama | claude
# 既定は ollama。ローカル実行なので API 料金は発生しない。
# claude に切り替えると Anthropic API への従量課金が発生する点に注意。
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_NUM_CTX=6144

# Claude を使う場合のみ設定する。絶対に Git にコミットしない / フロントエンドへ渡さない。
ANTHROPIC_API_KEY=
# 料金を抑えたい場合は claude-sonnet-5 や claude-haiku-4-5 に変更できる
CLAUDE_MODEL=claude-opus-5
